# Copy to .env.local. Everything has a safe default so the page runs without this file.

# Public site URL, used for canonical, Open Graph and JSON-LD. Open item 2.
NEXT_PUBLIC_SITE_URL=https://www.salonbbk.com.au

# Call tracking numbers. Defaults are the salon numbers. Open item 1.
NEXT_PUBLIC_PHONE_SMITHFIELD=0403 321 181
NEXT_PUBLIC_PHONE_CLEMTON=0488 659 237

# Google Tag Manager container. Left empty, nothing is injected. Open item 8.
NEXT_PUBLIC_GTM_ID=

# Before-and-after section. Set to true once real pairs are in public/images/results. Open item 3.
NEXT_PUBLIC_SHOW_RESULTS=false

# Lead delivery via Resend. Without a key the API route logs the lead and still redirects. Open item 7.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Salon BBK Website <leads@salonbbk.com.au>
LEAD_TO_EMAIL=info@salonbbk.com.au
